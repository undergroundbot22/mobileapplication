<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Recipe Title & Match Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_recipe_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Tomato Basil Pasta" />

            <TextView
                android:id="@+id/tv_recipe_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/pantry_green"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="@string/badge_ready_to_cook"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Missing ingredient notification (shown for almost-there matches) -->
        <TextView
            android:id="@+id/tv_recipe_missing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/expiry_warning"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Missing: 1 Parmesan Cheese"
            tools:visibility="visible" />

        <!-- Ingredients List -->
        <TextView
            android:id="@+id/tv_recipe_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            tools:text="Ingredients: Pasta (200g), Tomatoes (3 pcs), Garlic (2 cloves)" />

        <!-- Preparation Steps -->
        <TextView
            android:id="@+id/tv_recipe_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            tools:text="Steps: 1. Boil pasta in salted water. 2. Sauté garlic and tomatoes in olive oil. 3. Mix pasta with sauce." />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
